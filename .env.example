# Environment configuration for IzzyCheck MVP

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://izzycheck:${POSTGRES_PASSWORD}@postgres:5432/izzycheck?schema=public"

# Test database for `npm run test:db` (optional; default: docker-compose.test.yml on localhost:54329)
# The database name MUST end with `_test` (e.g. .../izzycheck_test), otherwise tests refuse to run.
TEST_DATABASE_URL=""

# App Secrets (STRICTLY REQUIRED - APP WILL NOT START WITHOUT JWT_SECRET)
JWT_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Initial Admin Seeding (OPTIONAL: set to seed initial admin user if database is empty)
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Audatex API Mode
# Set to 'true' ONLY for local development with mock fixtures. Default is 'false' (LIVE SOAP API).
AUDATEX_MOCK_MODE="false"

# Audatex AudaValuation WS Configuration
AUDATEX_VALUATION_ENDPOINT="https://te5adxwseu.taxexpert.cz/TE5_AUDAVIN_Service.asmx"
AUDATEX_VALUATION_SERVICE_ENDPOINT="https://te5wseu.taxexpert.cz/TE5_EvaluationServices.asmx"
AUDATEX_VEHICLE_DATA_ENDPOINT="https://te5wseu.taxexpert.cz/TE5_VehicleData.asmx"
AUDATEX_MARKET_CODE="PL"
AUDATEX_LANGUAGE="PL"
AUDATEX_CERTIFICATE_HASH=""
AUDATEX_LICENCE_NUMBER=""

# Audatex Claims History Engine (CHE) SOAP v1.23.0 Configuration
AUDATEX_CHE_ENDPOINT="https://vin-history-v2.eu.solera.com/service/ExternalVin"
AUDATEX_CHE_USERNAME=""
AUDATEX_CHE_PASSWORD=""
AUDATEX_CHE_COUNTRY="pl"
AUDATEX_CHE_CURRENCY="PLN"

# Timeouts & Retries for SOAP calls
AUDATEX_TIMEOUT_MS="15000"
AUDATEX_MAX_RETRIES="2"

# PayU online payments (credit shop). Leave any of these empty to disable online payments.
# PAYU_BASE_URL has no default in docker-compose (empty = payments disabled). Sandbox: https://secure.snd.payu.com; production: https://secure.payu.com
PAYU_BASE_URL="https://secure.snd.payu.com"
PAYU_POS_ID=""
PAYU_CLIENT_ID=""
PAYU_CLIENT_SECRET=""
PAYU_SECOND_KEY=""
# In production (NODE_ENV=production) the PayU sandbox is refused (payments disabled) unless this is "true".
# Sandbox payments grant real credits, so set it only for a deliberate test.
PAYU_ALLOW_SANDBOX="false"

# Fakturownia (faktury za zakupy kredytów). Puste FAKTUROWNIA_DOMAIN lub FAKTUROWNIA_API_TOKEN = faktury czekają (status "Do wystawienia").
# Subdomena konta bez ".fakturownia.pl" (np. "mojafirma")
FAKTUROWNIA_DOMAIN=""
FAKTUROWNIA_API_TOKEN=""
# Opcjonalne: id działu (firmy sprzedawcy) w Fakturowni
FAKTUROWNIA_DEPARTMENT_ID=""
# "true" = klienci mogą zamawiać faktury proforma (przelew). Domyślnie wyłączone; włącz dopiero po sprawdzeniu na prawdziwym koncie Fakturowni (README, "Proformy").
PROFORMA_ENABLED=""
# Sekret zadania cyklicznego /api/internal/billing-cron: długi losowy ciąg, np. `openssl rand -hex 32`
BILLING_CRON_SECRET=""
# "true" = fakturuj też zamówienia z sandboxu PayU (tylko test na stagingu, z testowym działem Fakturowni)
INVOICE_SANDBOX_ORDERS="false"
# Public https address of the app (used for the return page and the PayU notification URL)
APP_URL=""
