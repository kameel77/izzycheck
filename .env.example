# Environment configuration for IzzyCheck

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://izzycheck:izzycheck_password@localhost:5432/izzycheck?schema=public"

# App & Auth Secrets
JWT_SECRET="izzycheck-super-secret-jwt-key-change-in-production-2026"
NEXTAUTH_URL="http://localhost:3000"

# Audatex API Mode
# Set to 'true' for local testing and fixture mode, 'false' for live Audatex SOAP endpoints
AUDATEX_MOCK_MODE="true"

# Audatex AudaValuation WS Configuration
AUDATEX_VALUATION_ENDPOINT="https://te5adxwseu.taxexpert.cz/TE5_AUDAVIN_Service.asmx"
AUDATEX_VALUATION_SERVICE_ENDPOINT="https://te5wseu.taxexpert.cz/TE5_EvaluationServices.asmx"
AUDATEX_VEHICLE_DATA_ENDPOINT="https://te5wseu.taxexpert.cz/TE5_VehicleData.asmx"
AUDATEX_MARKET_CODE="PL"
AUDATEX_LANGUAGE="PL"
AUDATEX_CERTIFICATE_HASH=""
AUDATEX_LICENCE_NUMBER=""

# Audatex Claims History Engine (CHE) SOAP v1.23.0 Configuration
AUDATEX_CHE_ENDPOINT="https://vin-history-v2.eu.solera.com/service/ExternalVin"
AUDATEX_CHE_USERNAME=""
AUDATEX_CHE_PASSWORD=""
AUDATEX_CHE_COUNTRY="pl"
AUDATEX_CHE_CURRENCY="PLN"
