datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  USER
  OPERATOR
}

enum ReportModuleId {
  VALUATION
  CLAIM_CHECK
  CLAIM_DETAILS
}

enum ModuleStatus {
  NOT_REQUESTED
  PENDING
  RUNNING
  SUCCEEDED
  NO_DATA
  FAILED
}

enum BillingMode {
  PREPAID
  UNLIMITED
}

enum CreditType {
  VALUATION
  CLAIM_DETAILS
}

enum CreditLedgerType {
  USAGE
  MANUAL_ADJUSTMENT
  PURCHASE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
  FAILED
}

enum InvoiceStatus {
  NOT_REQUIRED
  PENDING
  ISSUING
  ISSUED
  FAILED
  NEEDS_ATTENTION
}

enum PaymentMethod {
  PAYU
}

enum CreditHoldStatus {
  HELD
  CAPTURED
  RELEASED
}

model Organization {
  id           String    @id @default(uuid())
  name         String
  nip          String    @unique
  street       String
  postalCode   String
  city         String
  country      String    @default("PL")
  billingEmail String
  isActive     Boolean   @default(true)
  billingMode  BillingMode @default(PREPAID)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
  reports      Report[]
  creditBalances CreditBalance[]
  creditHolds    CreditHold[]
  ledgerEntries  CreditLedgerEntry[]
  orders         Order[]

  @@map("organizations")
}

model User {
  id                      String        @id @default(uuid())
  email                   String        @unique
  name                    String
  passwordHash            String
  role                    Role          @default(USER)
  isActive                Boolean       @default(true)
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
  canGenerateValuation    Boolean       @default(false)
  canGenerateClaimCheck   Boolean       @default(false)
  canGenerateClaimDetails Boolean       @default(false)
  canViewOrgReports       Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  reports                 Report[]
  auditEvents             AuditEvent[]
  ledgerEntries           CreditLedgerEntry[]
  orders                  Order[]

  @@index([organizationId])
  @@map("users")
}

model Report {
  id                    String               @id @default(uuid())
  publicReference       String?              @unique
  vin                   String
  firstRegistrationDate String
  mileage               Int?
  valuationDate         String
  status                String               @default("COMPLETED") // COMPLETED | PARTIALLY_FAILED | FAILED
  idempotencyKey        String?
  requestHash           String?
  pdfBytes              Bytes?
  pdfGeneratedAt        DateTime?
  pdfGeneratorVersion   String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  createdById           String
  createdBy             User                 @relation(fields: [createdById], references: [id])
  organizationId        String?
  organization          Organization?        @relation(fields: [organizationId], references: [id])
  moduleResults         ReportModuleResult[]
  vehicleSnapshot       VehicleSnapshot?
  damageClaims          DamageClaim[]
  creditHolds           CreditHold[]
  ledgerEntries         CreditLedgerEntry[]

  @@index([vin])
  @@index([createdById])
  @@index([organizationId])
  @@unique([createdById, idempotencyKey])
  @@index([createdById, requestHash])
  @@map("reports")
}

model ReportModuleResult {
  id               String         @id @default(uuid())
  reportId         String
  report           Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moduleId         ReportModuleId
  status           ModuleStatus
  retryCount       Int            @default(0)
  isNonRetryable   Boolean        @default(false)
  responseMetadata String?        @db.Text
  errorMessage     String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([reportId, moduleId])
  @@map("report_module_results")
}

model VehicleSnapshot {
  id                   String   @id @default(uuid())
  reportId             String   @unique
  report               Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  ibsCode              String
  make                 String
  model                String
  variant              String
  newPriceCv           Float
  marketPriceCob       Float
  technicalValueTh     Float
  mileageUsed          Int
  isAverageMileageUsed Boolean
  manufactureDate      String?
  standardEquipment    String   @db.Text
  optionalEquipment    String   @db.Text
  technicalSpecJson    String?  @db.Text
  createdAt            DateTime @default(now())

  @@map("vehicle_snapshots")
}

model DamageClaim {
  id                 String   @id @default(uuid())
  reportId           String
  report             Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  claimId            String
  accidentDate       String?
  claimDate          String?
  country            String?
  makeModel          String?
  mileage            Int?
  damageValue        Float?
  currency           String?  @default("PLN")
  isTotalLoss        Boolean  @default(false)
  mandateCode        String?
  mandateDescription String?
  damageZones        String   @db.Text
  significantParts   String   @db.Text
  damageAssessmentJson String? @db.Text
  createdAt          DateTime @default(now())

  @@map("damage_claims")
}

model AuditEvent {
  id           String   @id @default(uuid())
  userId       String?
  userEmail    String?
  action       String
  resource     String
  metadataJson String?  @db.Text
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_events")
}

model ReportReferenceSequence {
  period     String @id // Format: "YYYY-MM"
  currentVal Int    @default(0)

  @@map("report_reference_sequences")
}

model CreditBalance {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  creditType     CreditType
  balance        Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, creditType])
  @@map("credit_balances")
}

model CreditHold {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  reportId       String
  report         Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moduleId       ReportModuleId
  creditType     CreditType
  status         CreditHoldStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reportId, moduleId])
  @@index([organizationId, status, updatedAt])
  @@map("credit_holds")
}

model CreditLedgerEntry {
  id             String           @id @default(uuid())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  creditType     CreditType
  amount         Int              // -1 usage, 0 usage bez opłaty, +/-N korekta
  type           CreditLedgerType
  idempotencyKey String           @unique // "usage:{reportId}:{moduleId}" | "manual:{uuid}" | "purchase:{orderId}:{creditType}"
  reportId       String?
  report         Report?          @relation(fields: [reportId], references: [id])
  moduleId       ReportModuleId?
  userId         String?          // USAGE: report.createdById; MANUAL_ADJUSTMENT: admin
  user           User?            @relation(fields: [userId], references: [id])
  note           String?
  orderId        String?
  order          Order?           @relation(fields: [orderId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
  @@map("credit_ledger_entries")
}

model CreditPackage {
  id             String      @id @default(uuid())
  name           String
  creditType     CreditType
  credits        Int
  priceNetGrosze Int
  vatRate        Int         @default(23)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]

  @@map("credit_packages")
}

model Order {
  id               String              @id @default(uuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id])
  userId           String
  user             User                @relation(fields: [userId], references: [id])
  status           OrderStatus         @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod
  totalNetGrosze   Int
  totalVatGrosze   Int
  totalGrossGrosze Int
  currency         String              @default("PLN")
  payuOrderId      String?             @unique
  payuRedirectUri  String?
  payuSandbox      Boolean             @default(false)
  paidAt           DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  items            OrderItem[]
  ledgerEntries    CreditLedgerEntry[]

  invoiceStatus        InvoiceStatus @default(NOT_REQUIRED)
  invoiceAttempts      Int           @default(0)
  invoiceNextAttemptAt DateTime?
  invoiceClaimedAt     DateTime?
  invoiceLastError     String?
  fakturowniaInvoiceId String?       @unique
  invoiceNumber        String?
  invoiceToken         String?
  invoiceIssuedAt      DateTime?
  invoiceEmailedAt     DateTime?
  ksefStatus           String?
  ksefId               String?
  ksefVerificationLink String?
  ksefCheckedAt        DateTime?

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([invoiceStatus, invoiceNextAttemptAt])
  @@map("orders")
}

model OrderItem {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageId         String
  package           CreditPackage @relation(fields: [packageId], references: [id])
  packageName       String
  creditType        CreditType
  creditsPerPackage Int
  quantity          Int
  unitNetGrosze     Int
  unitGrossGrosze   Int
  vatRate           Int
  lineNetGrosze     Int
  lineVatGrosze     Int
  lineGrossGrosze   Int

  @@index([orderId])
  @@map("order_items")
}
